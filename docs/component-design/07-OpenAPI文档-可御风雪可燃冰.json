  "paths": {
    "/search/works": {
      "get": {
        "tags": [
          "搜索"
        ],
        "summary": "检索公开成果",
        "operationId": "getSearchWorks",
        "responses": {
          "200": {
            "description": "公开候选经 RDS 复核",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "400": {
            "description": "统一错误响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "统一错误响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "关键词，空值允许浏览",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "成果类型",
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "patent",
                "project",
                "award"
              ]
            }
          },
          {
            "name": "yearFrom",
            "in": "query",
            "required": false,
            "description": "起始年份含边界",
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          },
          {
            "name": "yearTo",
            "in": "query",
            "required": false,
            "description": "结束年份含边界",
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          },
          {
            "name": "domainId",
            "in": "query",
            "required": false,
            "description": "父领域包含子领域",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": false,
            "description": "机构",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataNature",
            "in": "query",
            "required": false,
            "description": "默认 real",
            "schema": {
              "type": "string",
              "enum": [
                "real",
                "all"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "排序",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "time"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页数量",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "绑定筛选条件的续页游标",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
