411083d2374462032dd1" xmi:type="uml:Activity"><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="5eb0d22b4097457d9faea9efee9921f8" xmi:type="uml:InitialNode"/><node name="[系统]&#10;C01 接收来源记录、待核验候选&#10;或可追溯误合并处理请求" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="6c69df4f5a9a454eb68b07ad0ce4d08e" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C02 是否为新来源记录？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="60657493dbd34d1db72e53cace7f67e4" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C03 保留原始值、来源与时间&#10;按类型校验最小字段和日期" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="9d914213511a4dd48654831593fe6d56" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C04 最小字段、类型与日期是否合格？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="bd56626c37034bd0869d0603613da81b" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C05 登记字段异常及原值&#10;不发布不合格记录" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="f86e0e69b1b242119ccb0198f10210f9" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C06 规范化标题、标识和引用&#10;保留日期精度、原值及规则版本" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="95c516c154754699a3b2a981cb9fd9e2" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C07 比对稳定标识的类型与作用域&#10;核验版本关系、冲突及人工保护" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="5e683e183ec54eb0a08279fc6f8225c1" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C08 无冲突且登记规则允许&#10;自动归并或已证实版本关联？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="e64123fdc7974a78a14ec75e860068a7" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C09 关联同一成果实体&#10;保留版本、来源、参与者及冲突事实" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="bb81dd1a497643a296225950b361c956" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C10 记录判定依据及前后映射&#10;按成果实体计数并反馈结果" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="821f9f78d09042fcafe0c107fcb65a4b" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C11 比较标题、年份、类型及参与者&#10;保留候选与冲突证据" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="11d35e5bb8b944ffb8b98f6bfb8a0c9c" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C12 无候选、无未决冲突&#10;且字段合格？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="12552852c9da4aa3a6d3bce2fb616a47" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C13 建立独立成果实体&#10;保留来源并反馈结果" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="556b529616384948bcc652aebc898af3" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C14 建立或关联原核验待办&#10;列出原因、原值、来源及规则版本" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="aa4ef5c5049b466cbc5746e668d68e49" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C15 读取已有候选或合并历史&#10;及来源、关系映射" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="6800ad5b8a5549a78125f889276eefa0" xmi:type="uml:OpaqueAction"/><node name="[治理管理员]&#10;C16 请求查看并处理核验待办" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="73249bbb44914f3b8502d1c865c20db8" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C17 对应治理权限有效&#10;且目标版本未变化？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="92ec58a82d26463998f6db804b13156c" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C18 拒绝本次处理并说明原因&#10;保持现有结果及核验待办" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="9baa392d0f1c48e7bc606c1bd1db44eb" xmi:type="uml:OpaqueAction"/><node name="[治理管理员]&#10;C19 比较证据后的决定？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="0e8813f78da0488b908254ef33898bfe" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C20 排除该候选&#10;保留原实体与全部来源" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="145723fe1f5d4b259001da37d98d420a" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C21 合并证据充分&#10;且冲突已核验？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="c31c9ab693ec43a5b50daee1cffc4427" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C22 保持待核验&#10;不覆盖人工确认值" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="747be467fd784b3eb62a01a75efd3b59" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C23 合并成果或关联已证实版本&#10;保留全部来源、角色顺序和人工值" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="098ae0a69a134d66b3ca760635a063ff" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C24 来源映射完整&#10;且关系归属明确？" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="851aee5f52af428e847adff89be32777" xmi:type="uml:DecisionNode"/><node name="[系统]&#10;C25 拒绝完成拆分&#10;保留原因并等待补充依据" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="5cb64059ed9b4507bc4f89ff364213d1" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C26 恢复拆分后的实体&#10;及各自来源、参与关系" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="dbae872a57aa4248bbb7a2d7a5fcf552" xmi:type="uml:OpaqueAction"/><node name="[系统]&#10;C27 记录操作者、时间、前后值与原因&#10;保留合并拆分历史，反馈生效结果" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="a638e34fecee4d6b988d91b16cfbbb31" xmi:type="uml:OpaqueAction"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="e23347c7eab8495e876f461851bc2498" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="b33eb0735f5c4f619ebf9ba15e6b8fff" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="8c836af1d966411ebe6ef94720861a9f" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="580b941bcfd24560a4301b4b0e0f98ce" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="7144ae0dbffb4f63906787a4aae815d5" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="c33dabacb4824701b4e8183f0c276587" xmi:type="uml:ActivityFinalNode"/><node name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="83fee945fb144ef1bc6500db5b69a89a" xmi:type="uml:ActivityFinalNode"/></packagedElement><packagedElement name="" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="3059d9ae4f1848f0b99e9977963da240" xmi:type="uml:Class"><ownedComment xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="_nN6_0MbaEfGLfrvdG